# ===== 必填 =====
# DeepSeek API Key（LLM 对话）
DEEPSEEK_API_KEY=

# DashScope API Key（ASR 语音转写 + Embedding 向量化）
DASHSCOPE_API_KEY=

# ===== LLM 配置 =====
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 关闭深度思考，让回答更快开始显示
LLM_THINKING_ENABLED=false

# ===== Embedding 配置 =====
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 仅用于提问时把问题转换成可检索的数字表示；不改变入库的批量转换与重试
# 每个网络阶段默认超时5秒，范围0.5–30秒；查询不额外重试，暂时故障可转关键词查找
QUERY_EMBEDDING_TIMEOUT_SECONDS=5

# ===== 声音与画面识别 =====
# 首版只分析音频；后续需要画面时可改为 audio_visual
KNOWLEDGE_ANALYSIS_MODE=audio
# 可以留空，复用 DASHSCOPE_API_KEY；真实密钥只填写到本地 .env
QWEN_OMNI_API_KEY=
QWEN_OMNI_MODEL=qwen3.8-omni-flash
# 根据密钥所属区域填写；此处为北京区域现有入口
QWEN_OMNI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OMNI_TIMEOUT=180
QWEN_OMNI_MAX_TOKENS=8192
VIDEO_SEGMENT_SECONDS=60
# 同时识别的音频片段数（1–4）；默认3，设1恢复逐段处理
AUDIO_TRANSCRIPTION_CONCURRENCY=3
# 默认打包并行检查最多12处交界；最多两包主检查+一包独立重复字确认
AUDIO_BOUNDARY_REVIEW_ENABLED=true
AUDIO_BOUNDARY_BATCH_ENABLED=true
AUDIO_BOUNDARY_BATCH_RADIUS_SECONDS=5
AUDIO_BOUNDARY_BATCH_MAX_WINDOWS=12
# 关闭打包模式时使用的旧逐窗方式；REVIEW_ENABLED=false关闭所有补听
AUDIO_BOUNDARY_REVIEW_MAX_WINDOWS=4
AUDIO_BOUNDARY_REVIEW_RADIUS_SECONDS=8
# 每个补听网络阶段短超时、无SDK重试；60秒后不再发新的补听请求
AUDIO_BOUNDARY_REVIEW_TIMEOUT_SECONDS=20
AUDIO_BOUNDARY_REVIEW_BUDGET_SECONDS=60
VIDEO_CACHE_DIR=app/storage/video_cache
# 本地记录每次入库各阶段耗时；不会写入密钥或模型请求内容
INGESTION_METRICS_DIR=app/storage/ingestion_runs
# 长视频测试期间可设 true，保留约 6–31 分钟原声供回听；测试后可关闭
LONG_VIDEO_TEST_KEEP_AUDIO=false

# ===== ASR 配置 =====
# DashScope 语音识别模型
ASR_MODEL=paraformer-v2

# ===== 检索参数（保持默认即可）=====
RETRIEVAL_TOP_K=8
# 语义候选 + 中文词法检索融合；只用范围内的原文，不额外生成摘要
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_CANDIDATE_K=32
# 命中片段最多补350字相邻原文，以保留完整句
RETRIEVAL_NEIGHBOR_CHARS=350
RETRIEVAL_MMR_FETCH_K=32
RETRIEVAL_MMR_LAMBDA=0.55
RAG_CONTEXT_COUNT=8
RAG_PROMPT_MAX_CONTEXT_CHARS=8000

# ===== 切块参数 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== 对话 =====
CHAT_HISTORY_WINDOW=6
CHAT_MAX_CONTENT_CHARS=2000

# ===== 数据库 =====
DATABASE_URL=sqlite:///app/storage/douyinrag.db
CHROMA_PERSIST_DIR=app/storage/chroma

# ===== 音频缓存 =====
AUDIO_CACHE_DIR=app/storage/audio_cache
